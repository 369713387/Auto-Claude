# Auto detect text files and normalize to LF
* text=auto

# Source code files - enforce LF line endings
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf

# Config files - enforce LF line endings
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.env* text eol=lf

# Documentation - enforce LF line endings
*.md text eol=lf
*.txt text eol=lf
*.rst text eol=lf

# Web files - enforce LF line endings
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.less text eol=lf

# Binary files - don't touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.zip binary
*.tar binary
*.gz binary
*.node binary
